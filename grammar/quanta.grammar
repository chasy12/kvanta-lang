@top Program { statement* }

@skip { whitespace | Comment }

@precedence {
  unary @right
  mult @left
  add @left
  shift @left
  bitAnd @left
  bitXor @left
  bitOr @left
  compare @left
  and @left
  or @left
}

statement {
  Function | GlobalBlock | VariableDeclaration | Assignment |
  FunctionCall ";"? | IfExpression | ForExpression | WhileExpression |
  ReturnExpression | BreakExpression | ContinueExpression
}

GlobalBlock { Global Block }
Comment { CommentInfo }

Function { Func FuncName "(" Args? ")" ("->" TypeName)? Block }
FunctionCall { FuncName "(" Params? ")" }
FuncName { Name | Type }
Args { Arg ("," Arg)* }
Arg { TypeName Name ArrayDimension* }

VariableDeclaration { TypeName Name ArrayDimension* ("=" expression)? ";" }
ArrayDimension { "[" Number "]" }
Assignment { Variable "=" expression ";" }
Variable { Name Index* }
Index { "[" expression "]" }

IfExpression { If "(" expression ")" Block ElseExpression? }
ElseExpression { Else (Block | IfExpression) }
ForExpression { For Name In (Range | expression) Block }
Range { "(" expression ".." expression ")" }
WhileExpression { While "(" expression ")" Block }
ReturnExpression { Return expression ";" }
BreakExpression { Break ";" }
ContinueExpression { Continue ";" }
Block { "{" statement* "}" }

Params { (NamedArgument | expression) ("," (NamedArgument | expression))* }
NamedArgument { (Name | Type) ":" expression }

expression {
  FunctionCall | Variable | String | Boolean | Number | Float | Color | Key |
  ArrayLiteral | ParenthesizedExpression | UnaryExpression | BinaryExpression
}

ArrayLiteral { "{" (expression ("..." | ("," expression)*))? "}" }
ParenthesizedExpression { "(" expression ")" }
UnaryExpression { !unary UnaryOp { "!" | "-" | "+" } expression }
BinaryExpression {
  expression !add ArithOp { "+" | "-" } expression |
  expression !mult ArithOp { "*" | Division | "%" } expression |
  expression !shift BitOp { "<<" | ">>" } expression |
  expression !bitAnd BitOp { "&" } expression |
  expression !bitXor BitOp { "^" } expression |
  expression !bitOr BitOp { "|" } expression |
  expression !compare CompareOp { ">" | ">=" | "<" | "<=" | "==" | "!=" } expression |
  expression !and LogicOp { "&&" } expression |
  expression !or LogicOp { "||" } expression
}

TypeName { Const? (Type | ArrayType) }
ArrayType { Array "<" TypeName "," Number ">" }
Type { @specialize[@name=Type]<Name, "bool" | "char" | "int" | "float" | "color" | "string"> }
Boolean { @specialize<Name, "true" | "false"> }
If { @specialize[@name=If]<Name, "if"> }
In { @specialize[@name=In]<Name, "in"> }
For { @specialize[@name=For]<Name, "for"> }
While { @specialize[@name=While]<Name, "while"> }
Else { @specialize[@name=Else]<Name, "else"> }
Return { @specialize[@name=Return]<Name, "return"> }
Break { @specialize[@name=Break]<Name, "break"> }
Continue { @specialize[@name=Continue]<Name, "continue"> }
Global { @specialize[@name=Global]<Name, "global"> }
Const { @specialize[@name=Const]<Name, "const"> }
Array { @specialize[@name=Array]<Name, "array"> }
Color { @specialize[@name=Color]<Name, "Color"> "::" Name }
Key { @specialize[@name=Key]<Name, "Key"> "::" Name }
Func { @specialize[@name=Func]<Name, "func"> }

@tokens {
  whitespace { $[ \t\n\r]+ }
  Name { @asciiLetter $[a-zA-Z0-9_]* }
  Number { @digit+ }
  Float { @digit+ "." @digit+ }
  CommentInfo { "//" ![\n]* }
  Division { "/" }
  String { "\"" ("\\" _ | !["\\])* "\"" }
  @precedence { Name, Float, Number, CommentInfo, Division }
}

@external propSource quantaHighlight from "./highlight"
